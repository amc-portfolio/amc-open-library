{
    "name": "amc/openlibrary-php",
    "description": "An object-oriented PHP client for the Open Library API with typed search results, request throttling, and rate-limit retries.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "OpenLibrary\\": "src/OpenLibrary/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenLibrary\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "smoke": "php tests/live_smoke.php"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    }
}
